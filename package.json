{
  "name": "quantum-resonance-scan-glossary",
  "version": "1.0.0",
  "description": "Quantum Resonance Scan Glossary — plain-English health parameter reference",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder build --win --publish never"
  },
  "build": {
    "appId": "com.quantumresonance.glossary",
    "productName": "QRS Glossary",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "quantum-logo.svg"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QRS Glossary",
      "installerSidebar": "electron/installer-sidebar.bmp",
      "installerHeader": "electron/installer-header.bmp"
    }
  },
  "overrides": {
    "glob": "^11.0.0",
    "rimraf": "^6.0.0",
    "tar": "^7.4.3",
    "are-we-there-yet": "^4.0.0",
    "gauge": "^5.0.0",
    "npmlog": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
